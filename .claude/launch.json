    },
    {
      "name": "public-demo",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--env-file", ".env.demo", "uvicorn", "app.public.main:app", "--host", "127.0.0.1", "--port", "8011"],
      "port": 8011
    },
    {
      "name": "admin-demo",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--env-file", ".env.demo", "uvicorn", "app.admin.main:app", "--host", "127.0.0.1", "--port", "8010"],
      "port": 8010
    }
