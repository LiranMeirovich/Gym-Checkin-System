# Supply-chain settings for every npm command run in frontend/
# (the npm counterpart of decision 0011's SHA pinning).

# Exact versions in package.json: what's tested is what's installed.
save-exact=true

# Don't install a version published less than 7 days ago. Most malicious
# releases are caught and pulled within days.
min-release-age=7

# Don't run packages' install scripts, the usual way a hijacked package
# runs code on install. Nothing in this project needs them.
ignore-scripts=true

# Refuse to run on a Node version package.json doesn't allow.
engine-strict=true
