{
  "name": "gym-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev:admin": "vite --mode admin",
    "dev:public": "vite --mode public",
    "build": "npm run build:admin && npm run build:public",
    "build:admin": "vite build --mode admin",
    "build:public": "vite build --mode public",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:types": "uv run --directory .. python -m app.export_openapi admin frontend/node_modules/.tmp/openapi-admin.json && openapi-typescript node_modules/.tmp/openapi-admin.json -o src/admin/backend/schema.d.ts",
    "api:check": "npm run api:types && git diff --exit-code -- src/admin/backend/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
