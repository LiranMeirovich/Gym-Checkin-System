# Deployment config for one installation (decision 0013).
# Copy to .env and adjust. .env is git-ignored; this file is the committed
# template, so it only ever holds made-up values.
# Real environment variables override anything in .env.
# Every key must start with GYM_; an unknown key stops the app at startup.

# dev or prod. Without this line the app assumes prod.
GYM_ENVIRONMENT=dev

# SQLite database file, relative to the folder the app is started from.
GYM_DATABASE_PATH=gym.db

# IANA timezone used to show times (timestamps are stored in UTC).
GYM_TIMEZONE=Asia/Jerusalem

# Hostname phones use to reach the public app: bare, no https:// or path.
# Required in prod, optional in dev.
# GYM_PUBLIC_HOSTNAME=checkin.example.com
