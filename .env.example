# Deployment config for one installation (decision 0013).
# Copy to .env and adjust. .env is git-ignored; this file is the committed
# template, so it only ever holds made-up values.
# Real environment variables override anything in .env.
# Every key must start with GYM_. An unknown key in this file stops the app
# at startup; a blank value counts as unset.

# dev or prod. Without this line the app assumes prod.
GYM_ENVIRONMENT=dev

# SQLite database file, relative to the folder the app is started from.
# The apps never create it: run `uv run alembic upgrade head` first.
GYM_DATABASE_PATH=gym.db

# Encrypts the whole database file (SQLCipher): 64 hex characters.
# Required in prod; in dev, without it, the database is a plain SQLite file.
# Losing it loses the data and every backup: keep a copy off the machine.
# An existing plain database is converted once with
# `uv run python -m app.encrypt_database` (both apps stopped).
# Generate: uv run python -c "import secrets; print(secrets.token_hex(32))"
# Never commit a real key; this file holds only the placeholder.
# GYM_DATABASE_KEY=

# Folder the monthly reports (Excel and PDF) are saved in. Holds customer
# names and amounts: keep it out of the repo (git-ignored) and in backups.
GYM_REPORTS_DIR=reports

# IANA timezone used to show times (timestamps are stored in UTC).
GYM_TIMEZONE=Asia/Jerusalem

# Hostname phones use to reach the public app: bare, no https:// or path.
# Required in prod, optional in dev.
# GYM_PUBLIC_HOSTNAME=checkin.example.com

# Signs the admin app's CSRF tokens: random, at least 32 characters.
# Required in prod; in dev a random one is made at each start if unset.
# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit a real key; this file holds only the placeholder.
# GYM_SECRET_KEY=

# Mail server for the monthly report: STARTTLS on the port, the user is
# also the From address. Host, user and password go together. Required in
# prod; in dev, without a host, emails are saved to the outbox/ folder as
# .eml files instead of being sent. For Gmail, use an app password
# (Google account > Security > App passwords), never the account password.
# Never commit a real password; this file holds only placeholders.
# GYM_SMTP_HOST=smtp.gmail.com
# GYM_SMTP_PORT=587
# GYM_SMTP_USER=gym@example.com
# GYM_SMTP_PASSWORD=
